#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define THUMB_TAPPING_TERM_MS 200

/ {
    behaviors {
        // Wait for a non-modifier key before sending the one-shot modifier.
        thumb_sticky: thumb_sticky {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            lazy;
            ignore-modifiers;
        };

        thumb_mod: thumb_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&thumb_sticky>;
            flavor = "hold-preferred";
            tapping-term-ms = <THUMB_TAPPING_TERM_MS>;
        };

        thumb_layer: thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&thumb_sticky>;
            flavor = "hold-preferred";
            tapping-term-ms = <THUMB_TAPPING_TERM_MS>;
        };
    };

    macros {
        cpp_arrow: cpp_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp MINUS &kp GT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
                &kp ESC   &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I     &kp O   &kp P    &kp BSPC
                &kp TAB   &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp J   &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                           &thumb_mod LCTRL LGUI &thumb_layer LOWER LALT &kp SPACE     &kp RET &thumb_layer RAISE LALT &thumb_layer LOWER LCTRL
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
                &kp GRAVE &kp N1    &kp N2    &kp N3   &kp N4   &kp N5      &kp N6    &kp N7   &kp N8    &kp N9    &kp N0   &trans
                &kp CAPS  &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &kp PIPE
                &trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC &kp RBRC    &kp LBKT  &kp RBKT &cpp_arrow &kp UNDER &kp BSLH &trans
                                              &trans   &trans   &trans      &trans    &trans   &trans
            >;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
                &trans &kp PSCRN &kp PAUSE_BREAK &kp LC(LS(N3)) &kp LC(LS(N4)) &kp LC(LS(N5))  &kp DEL  &kp PG_UP    &kp UP        &kp PG_DN &kp INS &kp HOME
                &trans &kp LALT  &kp LCTRL       &kp LSHFT      &kp LG(LS(S))  &kp CAPS        &kp BSPC &kp LEFT     &kp DOWN      &kp RIGHT &kp DEL &kp END
                &trans &kp LC(Z) &kp LC(X)       &kp LC(C)      &kp LG(V)      &kp LG(SPACE)   &kp HOME &kp LC(LEFT) &kp LC(RIGHT) &kp END   &trans  &trans
                                                 &trans         &trans         &trans          &trans   &trans       &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
                &kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp F7 &kp F8       &kp F9     &kp F10      &kp F11 &kp F12
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans  &trans
                &trans     &trans       &trans       &trans       &trans       &trans       &trans &kp C_PREV   &kp C_PP   &kp C_NEXT   &trans  &trans
                                                     &trans       &trans       &trans       &trans &trans       &trans
            >;
        };
    };
};
